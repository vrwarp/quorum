# Copy to .env (git-ignored) and edit. Used by `docker compose`.

# Required. Shared password for the whole deployment: pick a long one.
QUORUM_PASSWORD=

# How the agents authenticate to Claude. Pick ONE, or leave all commented out and use
# Settings -> Sign in with Claude in the app after first login.
#   - an API key (pay per token):
# ANTHROPIC_API_KEY=
#   - a long-lived token from `claude setup-token` (uses your subscription):
# CLAUDE_CODE_OAUTH_TOKEN=

# Spend cap per room, in USD (default 20).
# QUORUM_MAX_BUDGET_USD_PER_ROOM=

# claude | fake. Empty = claude if ANTHROPIC_API_KEY is set, else fake.
# "fake" runs scripted agents (no Claude, no cost): good for a smoke test.
# QUORUM_RUNTIME=

# Only for `docker compose --profile caddy up -d`: the public host name whose
# DNS points at this machine. Caddy fetches a certificate for it.
# QUORUM_DOMAIN=
