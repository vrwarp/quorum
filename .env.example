# Copy to .env (git-ignored) and edit. `docker compose` reads this file twice: to fill in ${...} in compose.yml, and
# as the container's environment (env_file). Everything set here reaches the server; a variable exported in your
# shell does not.
#
# Single-quote a value that contains a dollar sign, or compose expands it (double quotes do not help):
#   QUORUM_PASSWORD='ab$cd9!x'
# Leave a setting you do not use commented out. An uncommented empty one (ANTHROPIC_API_KEY=) is passed on as an
# empty string.

# Required. Shared password for the whole deployment: pick a long one.
# The first person to log in becomes the admin, the only one who can sign the server in to Claude: log in
# yourself before you share the password.
QUORUM_PASSWORD=

# How the agents authenticate to Claude. Pick ONE, or leave all commented out and use
# Settings -> Sign in with Claude in the app after first login (admin only).
# An API key outranks the web sign-in, so setting one also moves billing to pay per token.
#   - an API key (pay per token):
# ANTHROPIC_API_KEY=
#   - a long-lived token from `claude setup-token` (uses your subscription):
# CLAUDE_CODE_OAUTH_TOKEN=

# Spend cap in USD (default 20) for each Agent SDK session, NOT for a room as a whole: a room's orchestrator, every
# exploration worker, every merge run and every digest writer gets its own cap, and the listener's classification calls
# are not capped at all. (QUORUM_MAX_BUDGET_USD_PER_ROOM, the old name, is read as this setting, with a warning.)
# QUORUM_MAX_BUDGET_USD_PER_SESSION=

# claude (default) | fake. With the default and no Claude credential yet, the agent shows "not signed in" and rooms
# work as plain chat until you sign in. "fake" runs scripted agents (no Claude, no cost): a smoke test, not real use.
# QUORUM_RUNTIME=

# 1: take the client address from X-Forwarded-For (needed behind Caddy or nginx, or every visitor looks like the
# proxy and the login throttle is shared by all). compose.yml defaults it to 1, because the container is only reachable
# through a proxy; set 0 only if something else talks to port 8787 directly.
# QUORUM_TRUST_PROXY=1

# Extra origins allowed to talk to the server from a browser (API posts and the WebSocket), comma-separated, each a full
# origin (https://quorum.example.com) or a bare host. A page is accepted when its host equals the Host header the server
# receives; list an origin only when the address people use differs from that (a proxy that rewrites Host, a second domain).
# QUORUM_ALLOWED_ORIGINS=

# Only for `docker compose --profile caddy up -d`: the public host name whose DNS points at this machine. Caddy fetches
# a certificate for it, and the caddy container refuses to start without it.
# QUORUM_DOMAIN=
