# Point QUORUM_DOMAIN's DNS at this host and Caddy gets a certificate on first
# start. WebSocket upgrades (/ws) are proxied without extra configuration, and
# reverse_proxy sends X-Forwarded-For and X-Forwarded-Proto, which Quorum reads for the
# client address (QUORUM_TRUST_PROXY=1, set by compose.yml) and the cookie's Secure flag.
# The container refuses to start without QUORUM_DOMAIN (see compose.yml): an empty site
# address is not a valid Caddyfile.
{$QUORUM_DOMAIN} {
	encode zstd gzip
	reverse_proxy quorum:8787
}
